# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> your cluster -> Connect -> Drivers
# Use the same cluster + database name here and in Render if you want localhost and the deployed site to show identical data.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret -> use a unique long random string in production
# Example generation: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_random_characters

# Server port (optional -> defaults to 5000)
PORT=5000

# Allowed frontend URLs for CORS (comma-separated)
# Example:
# CLIENT_URLS=http://localhost:5173,https://your-project.vercel.app,https://your-custom-domain.com
CLIENT_URLS=http://localhost:5173

# Optional: allow all Vercel preview deployments.
# Keep this false for production unless you understand that any *.vercel.app origin can call the API.
ALLOW_VERCEL_PREVIEWS=false

# Optional: temporary testing only. Keep false for public deployments.
ALLOW_ANY_HTTPS_ORIGIN=false

# Private production admin account.
# Set these in Render, not in GitHub. ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner Admin

# Optional: auto-create missing demo data whenever the backend connects to MongoDB.
# For public deployments, keep demo writes disabled. Demo accounts cannot use password login by default.
ENABLE_DEMO_BOOTSTRAP=true
DEMO_ACCESS_ENABLED=true
DEMO_WRITE_ACCESS=false
DEMO_PASSWORD_LOGIN_ENABLED=false

# Optional: only set these if you intentionally want password login for demo accounts.
# Public deployments should prefer /api/auth/demo read-only access instead.
DEMO_ADMIN_PASSWORD=
DEMO_COUNTER_PASSWORD=
DEMO_KITCHEN_PASSWORD=

# MongoDB Atlas reminder:
# Add your local IP or 0.0.0.0/0 in Atlas Network Access so localhost and Render can connect.
