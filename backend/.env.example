# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> your cluster -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret -> use a long random string in production
JWT_SECRET=your_strong_secret_key_here_change_this

# Server port (optional -> defaults to 5000)
PORT=5000

# Allowed frontend URLs for CORS in production (comma-separated)
CLIENT_URLS=http://localhost:5173

# Optional: allow all Vercel preview deployments
ALLOW_VERCEL_PREVIEWS=false
