# Local backend URL for Vite development
# If you want localhost to reflect the same live data as production, run your local backend with the same MONGO_URI used on Render.
VITE_API_URL=http://127.0.0.1:5000
VITE_SOCKET_URL=http://127.0.0.1:5000

# Optional: show read-only demo login buttons on the login screen.
# The backend must also have DEMO_ACCESS_ENABLED=true.
VITE_ENABLE_DEMO_LOGIN=true

# For Vercel production, set both values to your Render backend URL, for example:
# VITE_API_URL=https://your-backend.onrender.com
# VITE_SOCKET_URL=https://your-backend.onrender.com
